void TIM4_IRQHandler(void)
{
    if(TIM_GetITStatus(TIM4,TIM_IT_Update)==1)
    {

//        LED2=~LED2;
        if(IsGyroOffsetReset)
        {
            GyroOffset_init();             ///////零偏矫正过程中不进行姿态结算，并保证姿态模块静止
        }




    }
    TIM_ClearITPendingBit(TIM4,TIM_IT_Update);
}
void fastcompaccelBMX055(float * dest1)
{
	uint8_t compx,compy,compz;
	uint8_t c;
    WriteData(Acc_addr, BMX055_ACC_OFC_CTRL, 0x80); // set all accel offset compensation registers to zero
//设置所有加速偏移补偿寄存器为零
    WriteData(Acc_addr, BMX055_ACC_OFC_SETTING, 0x40);  // set offset targets to 0, 0, and +1 g for x, y, z axes
//设置x, y, z轴的偏移目标为0,0，和+1 g
    WriteData(Acc_addr, BMX055_ACC_OFC_CTRL, 0x20); // calculate x-axis offset
//计算x轴偏移量

     ReadData(Acc_addr, BMX055_ACC_OFC_CTRL,&c,1);
    while(!(c & 0x10))
    {   // check if fast calibration complete
        //检查快速校准是否完成
        ReadData(Acc_addr, BMX055_ACC_OFC_CTRL,&c,1);
        delay_ms(10);
    }
    WriteData(Acc_addr, BMX055_ACC_OFC_CTRL, 0x40); // calculate y-axis offset
//计算y轴偏移量

    
		ReadData(Acc_addr, BMX055_ACC_OFC_CTRL,&c,1);
    while(!(c & 0x10))
    {   // check if fast calibration complete
        ReadData(Acc_addr, BMX055_ACC_OFC_CTRL,&c,1);
        delay_ms(10);
    }
    WriteData(Acc_addr, BMX055_ACC_OFC_CTRL, 0x60); // calculate z-axis offset

   ReadData(Acc_addr, BMX055_ACC_OFC_CTRL,&c,1);
    while(!(c & 0x10))
    {   // check if fast calibration complete
         ReadData(Acc_addr, BMX055_ACC_OFC_CTRL,&c,1);
        delay_ms(10);
    }

    ReadData(Acc_addr, BMX055_ACC_OFC_OFFSET_X,&compx,1);
    ReadData(Acc_addr, BMX055_ACC_OFC_OFFSET_Y,&compy,1);
		ReadData(Acc_addr, BMX055_ACC_OFC_OFFSET_Z,&compz,1);

    dest1[0] = (float) compx/128.0f; // accleration bias in g
    dest1[1] = (float) compy/128.0f; // accleration bias in g
    dest1[2] = (float) compz/128.0f; // accleration bias in g
}
void get_acc(void)
{
    //acc
    ReadData(Acc_addr,ACC_XL,BMX055_ABUF,6);  //第一个为IIC地址，第二个为寄存器地址
		if((BMX055_ABUF[0] & 0x01) && (BMX055_ABUF[2] & 0x01) && (BMX055_ABUF[4] & 0x01))
		{  
			for(i = 0; i < 3; i ++) //0 1 2  0 1 2 3 4 5 12位
			{
					Acc_dat[i]=(float)((int16_t)((BMX055_ABUF[2*i+1] << 8) | BMX055_ABUF[2*i]) >> 4);


			}
		}

		Acc_dat[0]+=accelBias[0];
		Acc_dat[1]+=accelBias[1];
		Acc_dat[2]+=accelBias[2];
	
}
void get_gyro(void)
{
    //gyro
    ReadData(Gyro_addr,GYRO_XL,BMX055_GBUF,6);//16位
    for(i = 0; i < 3; i ++) //0 1 2  0 1 2 3 4 5
    {
        Gyro_dat[i]=(float)((int16_t)((BMX055_GBUF[2*i+1] << 8) | BMX055_GBUF[2*i]));


    }
    Gyro_dat[0]=Gyro_dat[0]-GyroOffset.Xdata;
    Gyro_dat[1]=Gyro_dat[1]-GyroOffset.Ydata;
    Gyro_dat[2]=Gyro_dat[2]-GyroOffset.Zdata;


}
void get_mag(float * magData)
{
	uint8_t rawData[8]; 
    //mag
    ReadData(Mag_addr,MAG_XL,rawData,6);
	if(rawData[6]&0x01)
	{
    for(i = 0; i < 2; i ++) //0 1   0 1 2 3  13位
    {
        magData[i] =(float)((int16_t)((rawData[2*i+1] << 8) | rawData[2*i]) >> 3) ;

//				Mag_dat[i]=(float)MBX055_Mag[i];
//        if(Mag_dat[i]> 4095)
//        {
//            Mag_dat[i] -= 8192;
//            Mag_dat[i]=Mag_dat[i]*MagxySen;
//        }
//        else
//        {
//            Mag_dat[i]=Mag_dat[i]*MagxySen;
//        }

    }

    magData[2]= (float)((int16_t)((rawData[5] << 8) | rawData[4]) >> 1) ;//15位

//		 Mag_dat[2]=(float)MBX055_Mag[2];
//    if(Mag_dat[2]> 16383)
//    {
//        Mag_dat[2] -= 32768;
//        Mag_dat[2]=Mag_dat[2]*MagzSen;
//    }
//    else
//    {
//        Mag_dat[2]=Mag_dat[2]*MagzSen;
//    }
    Mag_dat[0]=Mag_dat[0]*0.3173828;
    Mag_dat[1]=Mag_dat[1]*0.3173828;
    Mag_dat[2]=Mag_dat[2]*0.1525879;
    Mag_dat[0]=Mag_dat[0]-MagOffset.Xdata;
    Mag_dat[1]=Mag_dat[1]-MagOffset.Ydata;
    Mag_dat[2]=Mag_dat[2]-MagOffset.Zdata;
    Mag_dat[0]=Mag_dat[0]*0.7761+Mag_dat[1]*(-0.0009)+Mag_dat[2]*0.0176;
    Mag_dat[1]=Mag_dat[0]*(-0.009)+Mag_dat[1]*0.7371+Mag_dat[2]*(-0.0297);
    Mag_dat[2]=Mag_dat[0]*0.0176+Mag_dat[1]*(-0.0297)+Mag_dat[2]*1.7495;;
	}


}
 void magcalBMX055(float * dest1)
    {
        uint16_t ii = 0, sample_count = 0;
        int32_t mag_bias[3] = {0, 0, 0};
        int16_t mag_max[3] = {0, 0, 0}, mag_min[3] = {0, 0, 0};
 
        // ## "Mag Calibration: Wave device in a figure eight until done!" ##
        //wait(4);
 
        sample_count = 48;
        for(ii = 0; ii < sample_count; ii++)
        {
            int16_t mag_temp[3] = {0, 0, 0};
           
						get_mag(mag_temp);
            for (int jj = 0; jj < 3; jj++)
            {
                if(mag_temp[jj] > mag_max[jj]) mag_max[jj] = mag_temp[jj];
                if(mag_temp[jj] < mag_min[jj]) mag_min[jj] = mag_temp[jj];
            }
            delay_ms(105);  // at 10 Hz ODR, new mag data is available every 100 ms
        }
 
        mag_bias[0] = (mag_max[0] + mag_min[0])/2;  // get average x mag bias in counts
        mag_bias[1] = (mag_max[1] + mag_min[1])/2;  // get average y mag bias in counts
        mag_bias[2] = (mag_max[2] + mag_min[2])/2;  // get average z mag bias in counts
 
        // save mag biases in G for main program
        dest1[0] = (float) mag_bias[0]*mRes;
        dest1[1] = (float) mag_bias[1]*mRes;
        dest1[2] = (float) mag_bias[2]*mRes;
 
        // ## "Mag Calibration done!" ##
    }



